# ---------------------------------------------------------------------------
# Backend environment variables
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored and must NEVER be committed.
# None of these values are exposed to the frontend — the browser only ever
# sees VITE_* variables from frontend/.env.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---------------------------------------------
# Get this from Atlas: Connect > Drivers > Node.js, then replace <password>
# with your database user's password and add the database name in the path.
#
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
#
# Two things to check if connecting fails:
#   1. This machine's IP must be in Atlas > Network Access
#   2. A password containing @ : / ? # [ ] must be percent-encoded
MONGODB_URI=

# Which database inside the cluster to use. Set explicitly by the application,
# because the connection string Atlas gives you has no database in its path and
# the driver would otherwise silently default to one named "test".
MONGODB_DB_NAME=portfolio

# NOTE: `npm test` does not use this. The suite starts its own in-process
# MongoDB (mongodb-memory-server), so tests can never touch your real cluster.

# --- Authentication -------------------------------------------------------
# Generate a strong secret, do not reuse one from another project:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- CORS -----------------------------------------------------------------
# Exact origin of the frontend. Cannot be "*" because we send credentials.
CLIENT_URL=http://localhost:5173

# --- Admin seed account ---------------------------------------------------
# Used ONLY by `npm run db:seed:all` to create the first admin.
# The password is bcrypt-hashed before storage and is never stored in plain text.
# The seeder refuses to run if these are blank or if the password is too weak.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Portfolio Admin

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=2

# --- AI chatbot (not enabled yet — see README "Future Improvements") -------
# Leave blank. With no provider configured, POST /api/ai/chat returns a clean
# 503 and the rest of the application is unaffected.
AI_PROVIDER=none
AI_API_KEY=

# --- Cloudinary (profile picture + project thumbnails) ---------------------
# Dashboard > Settings > API Keys. The secret stays on the server: the admin
# panel uploads through POST /api/uploads/image, never straight to Cloudinary.
# Leave blank to disable uploads (image URLs can still be pasted by hand).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# --- Admin sessions -------------------------------------------------------
# Enforced server-side on every request. The login cookie itself is a browser
# session cookie, so closing the browser also signs out.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# --- Deployment -----------------------------------------------------------
# Number of reverse proxies in front of the API (1 behind a single load
# balancer). Leave at 0 when nothing sits in front: trusting X-Forwarded-For
# without a proxy lets clients fake their IP and bypass the login rate limit.
TRUST_PROXY=0
# Auth cookies are HTTPS-only automatically in production or when CLIENT_URL
# is https. Only set this to force it on for another setup.
# COOKIE_SECURE=true
